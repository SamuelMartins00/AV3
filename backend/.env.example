# Banco de dados (MySQL 8.0.16 ou superior)
DATABASE_URL="mysql://root:senha@localhost:3306/logistica_db"

# MySQL 8 (caching_sha2_password): a chave pública RSA é recuperada automaticamente
# quando o host é local. Para host remoto SEM TLS, definir "true" (menos seguro).
# DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# Banco EXCLUSIVO dos testes de integração
# O nome deve terminar em _test
TEST_DATABASE_URL="mysql://root:senha@localhost:3306/logistica_db_test"

# Redis / Memurai
REDIS_URL="redis://127.0.0.1:6379/0"
TEST_REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_PREFIX="greencode"

# Processamento assíncrono
WORKER_CONCURRENCY=5
TASK_MAX_ATTEMPTS=3
TASK_BACKOFF_MS=5000
TASK_STALE_MS=60000
TASK_RESULT_TTL_HOURS=168

# Servidor
PORT=3000
HOST=127.0.0.1

# Autenticação
JWT_SECRET="defina-uma-chave-longa-e-aleatoria"
JWT_ACCESS_EXPIRES=15m
REFRESH_TTL_MINUTES=30
BCRYPT_COST=10

# Proteção contra tentativas de autenticação (por IP + usuário no login)
LOGIN_RATE_LIMIT_MAX=10

# CORS: origens exatas separadas por vírgula; vazio mantém CORS desabilitado.
# Para Vite local, use http://localhost:5173. Inclua apenas origens confiáveis.
CORS_ORIGINS="http://localhost:5173"

# Agendamento recorrente de análises (desabilitado por padrão)
ANALYTICS_SCHEDULE_ENABLED=false
ANALYTICS_SCHEDULE_CRON="0 2 * * *"
ANALYTICS_SCHEDULE_TIMEZONE="America/Sao_Paulo"
