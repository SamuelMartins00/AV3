generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Enums existentes ----------

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum ResultadoTriagem {
  AGUARDANDO_AVALIACAO
  APROVADO_PARA_DESMONTAGEM
  DESTINADO_AO_REAPROVEITAMENTO_DE_PECAS
  DESTINADO_A_RECICLAGEM
  DESTINADO_AO_DESCARTE_SEGURO
}

enum EstadoOperacaoRenovacao {
  PENDENTE
  PROCESSANDO
  AGUARDANDO_NOVA_TENTATIVA
  CONCLUIDA
  INTERVENCAO_MANUAL
}

// ---------- Novos enums da AV3 ----------

enum PermissaoChaveApi {
  RASTREABILIDADE_LEITURA
  LOTES_LEITURA
  LOTES_ESCRITA
  EQUIPAMENTOS_LEITURA
  RELATORIOS_LEITURA
  ANALISES_LEITURA
  TAREFAS_LEITURA
  TAREFAS_ESCRITA
}

enum TipoAnalise {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE_EQUIPAMENTOS
  VIDA_UTIL_REMANESCENTE
}

enum TipoTarefa {
  GERACAO_RELATORIO
  ANALISE_EFICIENCIA
  ANALISE_RENTABILIDADE
  ANALISE_VIDA_UTIL
  ANALISE_COMPLETA
}

enum StatusTarefa {
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  FALHOU
  CANCELADA
}

// ---------- Autenticação ----------

model Usuario {
  id                        Int            @id @default(autoincrement())
  usuario                   String         @unique
  nomeExibicao              String
  hashSenha                 String
  papel                     PapelUsuario
  ativo                     Boolean        @default(true)
  senhaAlteracaoObrigatoria Boolean        @default(false)
  versaoSeguranca           Int            @default(1)
  ultimoAcesso              DateTime?
  criadoEm                  DateTime       @default(now())
  refreshTokens             RefreshToken[]

  @@index([ativo, papel])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEm  DateTime
  revogado  Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

// ---------- Domínio ----------

model Organizacao {
  id                Int      @id @default(autoincrement())
  razaoSocial       String
  cnpj              String   @unique
  inscricaoEstadual String?
  enderecoCompleto  String   @db.Text
  telefone          String?
  email             String?
  dataCadastro      DateTime @default(now())
  ativo             Boolean  @default(true)
  versao            Int      @default(1)

  contrato             Contrato?
  lotes                Lote[]
  chavesApi            ChaveApi[]
  tarefasAssincronas   TarefaAssincrona[]
  resultadosAnaliticos ResultadoAnalitico[]
}

model Contrato {
  id                    Int                           @id @default(autoincrement())
  organizacaoId         Int                           @unique
  organizacao           Organizacao                   @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  dataAssinatura        DateTime
  dataVencimento        DateTime
  clausulas             Json
  valorMensal           Decimal                       @db.Decimal(12, 2)
  renovacaoAutomatica   Boolean                       @default(false)
  duracaoRenovacaoMeses Int?
  encerradoEm           DateTime?                     @db.DateTime(3)
  motivoEncerramento    String?                       @db.Text
  versao                Int                           @default(1)
  operacoesRenovacao    OperacaoRenovacaoAutomatica[]
}

model OperacaoRenovacaoAutomatica {
  id                    Int                     @id @default(autoincrement())
  contratoId            Int
  contrato              Contrato                @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  vencimentoOriginal    DateTime                @db.DateTime(3)
  estado                EstadoOperacaoRenovacao @default(PENDENTE)
  tentativas            Int                     @default(0)
  tentativaIniciadaEm   DateTime?               @db.DateTime(3)
  reivindicacaoExpiraEm DateTime?               @db.DateTime(3)
  ultimaTentativaEm     DateTime?               @db.DateTime(3)
  proximaTentativaEm    DateTime?               @db.DateTime(3)
  concluidaEm           DateTime?               @db.DateTime(3)
  ultimaFalhaResumo     String?                 @db.Text
  criadoEm              DateTime                @default(now()) @db.DateTime(3)
  atualizadoEm          DateTime                @updatedAt @db.DateTime(3)

  @@unique([contratoId, vencimentoOriginal], map: "OperacaoRenovacaoAutomatica_contratoId_vencimentoOriginal_key")
  @@index([estado, proximaTentativaEm], map: "OperacaoRenovacaoAutomatica_estado_proximaTentativaEm_idx")
  @@index([estado, reivindicacaoExpiraEm], map: "OperacaoRenovacaoAutomatica_estado_reivindicacaoExpiraEm_idx")
  @@index([contratoId], map: "OperacaoRenovacaoAutomatica_contratoId_idx")
}

model Lote {
  id                  Int           @id @default(autoincrement())
  organizacaoId       Int
  organizacao         Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  dataEntrada         DateTime
  notaFiscal          String
  transportadora      String
  statusProcessamento StatusLote    @default(RECEBIDO)
  observacoes         String?       @db.Text
  triagemConcluidaEm  DateTime?     @db.DateTime(3)
  versao              Int           @default(1)
  equipamentos        Equipamento[]

  @@index([organizacaoId])
  @@index([dataEntrada])
}

model Equipamento {
  id                   Int                @id @default(autoincrement())
  codigoBarrasInterno  String             @unique
  loteId               Int
  lote                 Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  posicaoNoLote        Int
  tipo                 TipoEquipamento
  marca                String
  modelo               String
  anoFabricacao        Int
  estadoFisico         EstadoFisico
  statusRastreamento   StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  resultadoTriagem     ResultadoTriagem?
  triagemResponsavel   String?
  triagemEm            DateTime?          @db.DateTime(3)
  triagemJustificativa String?            @db.Text
  baixadoEm            DateTime?          @db.DateTime(3)
  baixaResponsavel     String?
  baixaJustificativa   String?            @db.Text
  pesoQuilogramas      Decimal            @db.Decimal(8, 3)
  versao               Int                @default(1)

  movimentacoes         Movimentacao[]
  avaliacoesRecuperacao AvaliacaoRecuperacao[]
  historicoFalhas       HistoricoFalha[]
  historicoDepreciacao  HistoricoDepreciacao[]

  @@unique([loteId, posicaoNoLote])
  @@index([resultadoTriagem])
  @@index([tipo, estadoFisico])
}

model Movimentacao {
  id            Int         @id @default(autoincrement())
  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String?     @db.Text

  @@index([equipamentoId])
  @@index([dataHora])
}

// ---------- Novos modelos analíticos ----------

model AvaliacaoRecuperacao {
  id            Int         @id @default(autoincrement())
  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  material             String
  estadoFisicoSnapshot EstadoFisico?
  valorEstimado        Decimal       @db.Decimal(12, 2)
  valorRealizado       Decimal?      @db.Decimal(12, 2)

  avaliadoEm  DateTime  @default(now()) @db.DateTime(3)
  realizadoEm DateTime? @db.DateTime(3)
  responsavel String?
  observacao  String?   @db.Text

  @@index([equipamentoId])
  @@index([avaliadoEm])
  @@index([material])
}

model HistoricoFalha {
  id            Int         @id @default(autoincrement())
  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  ocorridoEm  DateTime  @db.DateTime(3)
  descricao   String    @db.Text
  custoReparo Decimal?  @db.Decimal(12, 2)
  resolvido   Boolean   @default(false)
  resolvidoEm DateTime? @db.DateTime(3)
  observacao  String?   @db.Text

  @@index([equipamentoId, ocorridoEm])
  @@index([resolvido])
}

model HistoricoDepreciacao {
  id            Int         @id @default(autoincrement())
  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  dataReferencia        DateTime @db.DateTime(3)
  valorBase             Decimal  @db.Decimal(12, 2)
  valorAtual            Decimal  @db.Decimal(12, 2)
  valorDepreciado       Decimal  @db.Decimal(12, 2)
  percentualDepreciacao Decimal  @db.Decimal(7, 4)
  metodo                String
  observacao            String?  @db.Text

  criadoEm DateTime @default(now()) @db.DateTime(3)

  @@unique([equipamentoId, dataReferencia])
  @@index([equipamentoId, dataReferencia])
}

model ResultadoAnalitico {
  id            Int          @id @default(autoincrement())
  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  tipo          TipoAnalise
  titulo        String
  descricao     String?     @db.Text
  dados         Json
  parametros    Json?
  periodoInicio DateTime?   @db.DateTime(3)
  periodoFim    DateTime?   @db.DateTime(3)

  geradoEm     DateTime @default(now()) @db.DateTime(3)
  versaoModelo String?

  @@index([tipo, geradoEm])
  @@index([organizacaoId, tipo])
}

// ---------- API pública ----------

model ChaveApi {
  id            Int         @id @default(autoincrement())
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  nome       String
  prefixo    String
  hashChave  String @unique
  permissoes Json

  ativa       Boolean   @default(true)
  expiraEm    DateTime? @db.DateTime(3)
  ultimoUsoEm DateTime? @db.DateTime(3)
  criadoEm    DateTime  @default(now()) @db.DateTime(3)
  revogadoEm  DateTime? @db.DateTime(3)

  tarefas TarefaAssincrona[]

  @@index([organizacaoId, ativa])
  @@index([prefixo])
}

// ---------- Processamento assíncrono ----------

model TarefaAssincrona {
  id String @id @default(uuid()) @db.VarChar(36)

  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  chaveApiId Int?
  chaveApi   ChaveApi? @relation(fields: [chaveApiId], references: [id], onDelete: SetNull)

  tipo   TipoTarefa
  status StatusTarefa @default(PENDENTE)

  parametros     Json?
  resultado      Json?
  arquivoUrl     String? @db.Text
  formatoArquivo String?

  tentativas    Int @default(0)
  maxTentativas Int @default(3)

  erro        String?   @db.Text
  iniciadaEm  DateTime? @db.DateTime(3)
  concluidaEm DateTime? @db.DateTime(3)

  criadoEm     DateTime @default(now()) @db.DateTime(3)
  atualizadoEm DateTime @updatedAt @db.DateTime(3)

  @@index([status, criadoEm])
  @@index([organizacaoId, criadoEm])
  @@index([chaveApiId])
}

// ---------- Auditoria e configuração ----------

model JournalTransacao {
  id                 Int      @id @default(autoincrement())
  timestamp          DateTime @default(now())
  operacao           String
  entidade           String
  dadosAntes         Json?
  dadosDepois        Json?
  usuarioResponsavel String

  @@index([timestamp])
  @@index([entidade])
}

model ConfiguracaoGlobal {
  id                     Int     @id @default(1)
  aliquotaImpostos       Decimal @default(0.18) @db.Decimal(5, 4)
  coeficienteDepreciacao Decimal @default(0.2) @db.Decimal(5, 4)
  valorBaseDepreciacao   Decimal @default(1000) @db.Decimal(12, 2)
}
